---
import { DOWNLOAD, SITE } from '../config/products';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="shell"><div class="footer-grid"><div class="footer-brand"><a href="/" aria-label="Ultiplay home">ultiplay<span>.</span></a><p>Your Play. Your Way.</p><p>A multi-video player for Windows.<br />Built by Ultiplay LLC.</p></div><div><h2>EXPLORE</h2><a href="/#modes">Layout modes</a><a href="/#features">Features</a><a href="/#pricing">Free &amp; Gold</a><a href="/tech-demo">Tech demo</a><a href="/#faq">Common questions</a><a href="https://www.youtube.com/@UltiplayTech">YouTube</a><a href={SITE.downloadLive ? DOWNLOAD.href : '/#notify'}>{SITE.downloadLive ? 'Download Free' : 'Launch waitlist'}</a></div><div><h2>SUPPORT</h2><a href="/contact">Get in touch</a><a href="mailto:support@ultiplay.net">support@ultiplay.net</a><a href="/refunds">Refund Policy</a></div><div><h2>LEGAL</h2><a href="/legal">All legal documents</a><a href="/eula">EULA</a><a href="/terms">Terms of Service</a><a href="/privacy">Privacy Policy</a><a href="/licenses">Open-Source Licenses</a></div></div><div class="footer-bottom"><span>© {year} Ultiplay. All rights reserved.</span><a href="/#top">Back to top ↑</a></div></div></footer>
<style>
.site-footer{border-top:1px solid var(--line);padding-top:50px;background:#0d0f0e}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1.2fr 1fr;gap:36px}.footer-grid h2{font-family:var(--mono);font-size:10px;letter-spacing:1.4px;color:var(--muted);margin:0 0 22px}.footer-grid>div>a{display:block;font-size:12px;color:#c0c4b9;margin-bottom:13px}.footer-grid a:hover{color:var(--gold)}.footer-brand>a{font-size:34px!important;color:var(--paper)!important;font-weight:750;letter-spacing:-2px;line-height:1;margin-bottom:20px!important}.footer-brand>a span{color:var(--gold)}.footer-brand p{font-size:12px;color:var(--muted);line-height:1.8;margin:0 0 12px}.footer-bottom{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding:24px 0;margin-top:45px;font-size:10px;color:var(--muted)}@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr;gap:35px 20px}}@media(max-width:400px){.footer-grid{grid-template-columns:1fr}.footer-bottom{flex-direction:column}}
</style>
