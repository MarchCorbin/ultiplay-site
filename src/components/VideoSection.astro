---
import { MEDIA } from '../config/products';
---

<section id="commercial" class="relative mx-auto max-w-5xl px-6 py-20">
	<!-- Legacy #demo anchors (Hero/Nav bookmarks) still land on the commercial -->
	<div id="demo" class="absolute -top-24" aria-hidden="true"></div>

	<div class="mb-10 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-fuchsia-300">Commercial</p>
		<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
			See Ultiplay in action
		</h2>
		<p class="mt-3 text-slate-400">
			The official Ultiplay commercial — watch every screen come alive.
		</p>
	</div>

	<div class="relative">
		<div class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-r from-fuchsia-500/25 to-cyan-400/25 blur-3xl"></div>
		<div class="relative aspect-video overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl shadow-fuchsia-500/10">
			<iframe
				class="h-full w-full"
				src={MEDIA.commercial.embedUrl}
				title={MEDIA.commercial.title}
				loading="lazy"
				frameborder="0"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
			></iframe>
		</div>
	</div>

	<div id="tech-demo" class="mt-16 scroll-mt-28 border-t border-white/10 pt-14">
		<div class="mb-8 text-center">
			<p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Longer look</p>
			<h3 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
				Tech demo
			</h3>
			<p class="mx-auto mt-3 max-w-2xl text-slate-400">
				Want the deeper walkthrough? This longer tech demo covers layout modes, control, and capture in more detail.
			</p>
		</div>

		<div class="relative mx-auto max-w-3xl">
			<div class="relative aspect-video overflow-hidden rounded-2xl border border-white/10 bg-black shadow-xl shadow-black/40">
				<iframe
					class="h-full w-full"
					src={MEDIA.techDemo.embedUrl}
					title={MEDIA.techDemo.title}
					loading="lazy"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				></iframe>
			</div>
			<p class="mt-4 text-center text-sm text-slate-500">
				<a
					href={MEDIA.techDemo.watchUrl}
					target="_blank"
					rel="noopener"
					class="text-slate-400 underline decoration-white/15 underline-offset-4 transition hover:text-white"
				>
					Open the tech demo on YouTube
				</a>
			</p>
		</div>
	</div>
</section>
