---
import { MEDIA } from '../config/products';
---
<section id="commercial" class="shell section-space">
  <div id="demo"></div>
  <div class="section-top"><div><p class="eyebrow">03 / SEE THE BIGGER PICTURE</p><h2 class="section-heading">This is Ultiplay.</h2></div><a href="/tech-demo" class="text-link">Watch the full walkthrough <span aria-hidden="true">↗</span></a></div>
  <div class="film-frame"><iframe src={MEDIA.commercial.embedUrl} title={MEDIA.commercial.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
  <div class="film-caption"><span>ULTIPLAY / THE OFFICIAL FILM</span><a href={MEDIA.commercial.watchUrl}>Watch on YouTube ↗</a></div>
</section>
<style>
.film-frame{aspect-ratio:16/9;background:#080909;border:1px solid var(--line)}.film-frame iframe{display:block;width:100%;height:100%;border:0}.film-caption{display:flex;justify-content:space-between;gap:20px;padding-top:16px;font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:1px}.film-caption a{letter-spacing:0}@media(max-width:500px){.film-caption{font-size:9px}}
</style>
