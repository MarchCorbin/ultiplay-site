---
import { DOWNLOAD, PRICING, SITE, STRIPE } from '../config/products';
const freeHref = SITE.downloadLive ? DOWNLOAD.href : '/#notify';
const goldHref = SITE.goldLive ? STRIPE.goldPurchase : '/#notify';
const rows = [
 { label: 'Simultaneous players', free: 'Up to 3', gold: 'Unlimited*' },
 { label: 'All video & image formats', free: 'Included', gold: 'Included' },
 { label: 'Drag & drop', free: 'Included', gold: 'Included' },
 { label: 'Smart playlists & play-next queue', free: 'Included', gold: 'Included' },
 { label: 'Saved layouts', free: 'Unlimited', gold: 'Unlimited' },
 { label: 'Classic, Grid, Screen Maximize & Mosaic', free: 'All 4', gold: 'All 4' },
 { label: 'URL & stream playback', free: 'Included', gold: 'Included' },
 { label: 'Basic fullscreen', free: 'Included', gold: 'Included' },
 { label: 'Webcams & Screen Player', free: 'Included', gold: 'Included' },
 { label: 'DJ Dashboard', free: '—', gold: 'Included' },
 { label: 'Mirror & sync', free: '—', gold: 'Included' },
 { label: 'Duplicate playlists', free: '—', gold: 'Included' },
 { label: 'Screen recording & screenshots', free: '—', gold: 'Included' },
 { label: 'Advanced shortcuts & player swapping', free: '—', gold: 'Included' },
 { label: 'Priority support', free: '—', gold: 'Included' },
];
---
<section id="pricing" class="pricing-section">
  <div class="shell section-space"><div class="section-top"><div><p class="eyebrow">04 / MAKE IT YOURS</p><h2 class="section-heading">Start with Free.<br />Go all in with Gold.</h2></div><p class="section-copy">Try Ultiplay with your own videos. Upgrade when you want more players and the full control toolkit.</p></div>
    <div class="pricing-grid">
      <article class="free-plan"><p class="plan-label">ULTIPLAY FREE</p><h3>Your everyday player.</h3><div class="plan-price">$0 <span>forever</span></div><p>For watching up to three videos at once.</p><ul><li>Up to 3 simultaneous players</li><li>Every layout mode</li><li>Local files, streams, webcams &amp; Screen Player</li><li>Smart playlists &amp; unlimited saved layouts</li><li>No ads, watermark, or time limit</li></ul><a href={freeHref} data-os-cta class="button button-outline"><span data-os-cta-label>{SITE.downloadLive ? 'Download Free' : 'Get notified'}</span><span aria-hidden="true">↓</span></a><p class="fineprint" data-os-note>Windows 10 / 11 · 64-bit · No account needed</p></article>
      <article class="gold-plan"><div class="gold-plan-heading"><p class="plan-label">ULTIPLAY GOLD</p><span class="purchase-type">ONE-TIME PURCHASE</span></div><h3>Your complete video wall.</h3><div class="plan-price">{PRICING.goldPrice}<span>USD + applicable tax</span></div><p>Everything in Free, with room to do more.</p><ul><li><strong>Unlimited players*</strong> — go beyond the 3-player limit</li><li><strong>DJ Dashboard</strong> — manage the whole set</li><li><strong>Mirror &amp; sync</strong> — coordinate your screens</li><li><strong>Recording &amp; screenshots</strong> — capture the moment</li><li>Duplicate playlists, advanced controls &amp; priority support</li></ul><a href={goldHref} data-gold-position="pricing" class="button button-gold">{SITE.goldLive ? `Get Ultiplay Gold — ${PRICING.goldPrice}` : 'Get notified about Gold'}<span aria-hidden="true">↗</span></a><p class="gold-reassurance">No subscription · Lifetime updates · 14-day refund window</p><p class="fineprint">*The number of videos your computer can play depends on its hardware and the media.</p></article>
    </div>
    <p class="purchase-note">Sold by Ultiplay LLC. Secure checkout via Stripe. Purchases are subject to our <a href="/eula">EULA</a>, <a href="/terms">Terms of Service</a>, and <a href="/refunds">Refund Policy</a>.</p>
    <details class="comparison-details"><summary>Compare every feature <span aria-hidden="true">+</span></summary><div class="comparison-table"><table><caption class="sr-only">Ultiplay Free and Gold feature comparison</caption><thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Gold</th></tr></thead><tbody>{rows.map(row => <tr><th scope="row">{row.label}</th><td>{row.free}</td><td>{row.gold}</td></tr>)}</tbody></table></div></details>
  </div>
</section>
<style>
.pricing-section{background:#eae7dc;color:#20231e}.pricing-section .eyebrow{color:#6b5228}.pricing-section .section-copy{color:#61655c}.pricing-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:0;align-items:stretch}.free-plan{padding:38px 40px 35px;border:1px solid #c7c7b9;border-right:0}.gold-plan{padding:38px 40px 35px;background:#171a17;color:#f0eee6;border-top:4px solid #b88733}.plan-label{font-family:var(--mono);font-size:11px;letter-spacing:2px;margin:0;font-weight:700}.gold-plan .plan-label{color:var(--gold)}.gold-plan-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.purchase-type{font-family:var(--mono);font-size:9px;color:var(--gold);border:1px solid #645434;padding:6px 9px;letter-spacing:.6px}.pricing-grid h3{font-size:28px;line-height:1.2;font-weight:600;letter-spacing:-1px;margin:25px 0}.plan-price{font-size:64px;line-height:1;font-weight:600;letter-spacing:-3px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}.plan-price span{font-size:11px;letter-spacing:0;font-weight:400;color:#686c62}.gold-plan .plan-price span{color:#b8bcb1}.pricing-grid article>p:not([class]){font-size:15px;line-height:1.6;margin:20px 0;color:#60655b}.pricing-grid .gold-plan>p:not([class]){color:#b8bcb1}.pricing-grid ul{list-style:none;padding:0;margin:26px 0 30px;display:grid;gap:14px}.pricing-grid li{position:relative;font-size:13px;line-height:1.6;padding-left:22px}.pricing-grid li::before{content:'✓';position:absolute;left:0;color:#637449}.gold-plan li{color:#d9dcd3}.gold-plan li::before{color:var(--gold)}.pricing-grid .button{display:flex;width:100%;margin-top:auto}.free-plan .button-outline{color:#23291f;border-color:#a1a692}.free-plan .button-outline:hover{background:#d9dacd}.free-plan .fineprint{color:#65695f;margin:14px 0 0}.gold-plan .fineprint{color:#a5ad9d;margin:12px 0 0;font-size:11px}.gold-reassurance{text-align:center;font-size:11px;color:#d7c49c;margin:13px 0 0;line-height:1.7}.purchase-note{font-size:11px;line-height:1.8;color:#676c61;max-width:800px;margin:22px 0}.purchase-note a{text-decoration:underline;text-underline-offset:3px}.comparison-details{border-block:1px solid #c0c3b5;margin-top:32px}.comparison-details summary{padding:22px 0;font-size:15px;font-weight:600;cursor:pointer;display:flex;justify-content:space-between}.comparison-details summary::-webkit-details-marker{display:none}.comparison-details[open] summary span{transform:rotate(45deg)}.comparison-table{overflow-x:auto;padding-bottom:20px}.comparison-table table{width:100%;border-collapse:collapse;font-size:12px}.comparison-table th,.comparison-table td{padding:14px 12px;border-bottom:1px solid #d0d1c5;text-align:left}.comparison-table tbody th{font-weight:400}.comparison-table td:last-child,.comparison-table thead th:last-child{font-weight:700;color:#4b582e}.comparison-table th:not(:first-child),.comparison-table td{text-align:center;width:20%}@media(max-width:850px){.pricing-grid{grid-template-columns:1fr}.free-plan{border-right:1px solid #c7c7b9}.gold-plan{order:-1}.free-plan,.gold-plan{padding:30px}.plan-price{font-size:58px}.pricing-grid h3{font-size:27px}}@media(max-width:400px){.free-plan,.gold-plan{padding:25px 20px}.gold-plan-heading{align-items:start;flex-direction:column}.purchase-type{font-size:8px}.comparison-table th,.comparison-table td{padding:12px 6px;font-size:11px}}
</style>
