---
const features = [
  { n: '01', title: 'Build a bigger video wall.', body: 'Open more than three players and keep adding videos as your setup grows. Gold removes the player limit; your hardware sets the practical ceiling.', tag: 'UNLIMITED PLAYERS' },
  { n: '02', title: 'Run the whole show.', body: 'Manage per-player seek bars, volume, and playlists from the DJ Dashboard. Keep control of the entire set without hopping between windows.', tag: 'DJ DASHBOARD' },
  { n: '03', title: 'Keep your screens together.', body: 'Mirror a player to another screen, synchronize playback, and duplicate playlists for a repeatable multi-monitor setup.', tag: 'MIRROR + SYNC' },
  { n: '04', title: 'Capture what’s playing.', body: 'Record your screen and take screenshots with the built-in capture tools. Keep the moments you want to return to.', tag: 'RECORDING + SCREENSHOTS' },
];
---
<section id="features" class="features-section">
  <div class="shell section-space">
    <div class="sources-row"><p class="eyebrow">BRING IT ALL TOGETHER</p><h2>Local videos. Live streams.<br />Cameras. Even your screen.</h2><p>Mix sources in the same setup. Queue what plays next, control each player, and save your favorite layouts. All included in Free.</p></div>
    <div class="gold-story"><div class="gold-story-intro"><p class="eyebrow">02 / TAKE CONTROL WITH GOLD</p><h2 class="section-heading">More screens.<br />More control.<br /><span>Your whole setup.</span></h2><p class="section-copy">Already using Ultiplay? Gold opens up the tools for a bigger, more flexible video wall.</p><a href="#pricing" class="text-link">See Free &amp; Gold <span aria-hidden="true">↗</span></a></div><div class="feature-list">{features.map(feature => <article><span class="feature-number">{feature.n}</span><div><p class="feature-tag">GOLD / {feature.tag}</p><h3>{feature.title}</h3><p>{feature.body}</p></div></article>)}</div></div>
  </div>
</section>
<style>
.features-section{background:#1b1d1c;border-block:1px solid var(--line)}.sources-row{display:grid;grid-template-columns:.7fr 1.2fr 1fr;align-items:start;gap:45px;border-bottom:1px solid #42443f;padding-bottom:65px;margin-bottom:75px}.sources-row h2{font-size:28px;line-height:1.25;letter-spacing:-.8px;margin:0}.sources-row>p:last-child{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.gold-story{display:grid;grid-template-columns:1fr 1.1fr;gap:85px}.gold-story-intro .section-heading{font-size:clamp(36px,4vw,54px)}.gold-story-intro .section-heading span{color:var(--gold)}.gold-story-intro .section-copy{font-size:16px;max-width:350px;margin-bottom:26px}.feature-list article{display:grid;grid-template-columns:28px 1fr;gap:20px;padding:25px 0;border-bottom:1px solid #42443f}.feature-list article:first-child{padding-top:0}.feature-list article:last-child{border:0;padding-bottom:0}.feature-number{font-family:var(--mono);font-size:11px;color:var(--muted);padding-top:3px}.feature-tag{font-family:var(--mono);font-size:9px;letter-spacing:1.2px;color:var(--gold);margin:0 0 10px}.feature-list h3{font-size:24px;font-weight:600;letter-spacing:-.6px;margin:0 0 12px}.feature-list article div>p:last-child{font-size:14px;line-height:1.8;color:var(--muted);margin:0}@media(max-width:900px){.sources-row{grid-template-columns:1fr;gap:20px;padding-bottom:40px;margin-bottom:45px}.gold-story{grid-template-columns:1fr;gap:40px}.gold-story-intro .section-copy{max-width:500px}.feature-list h3{font-size:23px}}
</style>
