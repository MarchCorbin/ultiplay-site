---
import { DOWNLOAD, PRICING, SITE, STRIPE } from '../config/products';
const primaryHref = SITE.downloadLive ? DOWNLOAD.href : '/#notify';
const goldHref = SITE.goldLive ? STRIPE.goldPurchase : '/#notify';
---
<section class="shell final-cta section-space"><div><p class="eyebrow">YOUR PLAY. YOUR WAY.</p><h2 class="section-heading">Make room<br />for more.</h2></div><div class="final-actions"><a href={goldHref} data-gold-position="closing" class="button button-gold">{SITE.goldLive ? `Get Gold — ${PRICING.goldPrice}` : 'Get notified about Gold'} <span aria-hidden="true">↗</span></a><a href={primaryHref} data-os-cta class="text-link"><span data-os-cta-label>{SITE.downloadLive ? 'Try Ultiplay Free first' : 'Get notified at launch'}</span> <span aria-hidden="true">↓</span></a><p class="fineprint" data-os-note>For Windows 10 / 11 · 64-bit</p></div></section>
<style>.final-cta{display:flex;justify-content:space-between;align-items:center;gap:40px}.final-cta h2{font-size:clamp(58px,6vw,86px);margin-bottom:0}.final-actions{display:flex;flex-direction:column;align-items:start;gap:22px}.final-actions .fineprint{margin:0}@media(max-width:650px){.final-cta{align-items:start;flex-direction:column;gap:30px}}</style>
