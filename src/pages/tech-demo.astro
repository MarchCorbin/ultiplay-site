---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DOWNLOAD, MEDIA, SITE } from '../config/products';

const ctaHref = SITE.downloadLive ? DOWNLOAD.href : '/#notify';
const ctaLabel = SITE.downloadLive ? 'Download Free' : 'Get notified';
---

<Layout
	title="Ultiplay tech demo — layout modes, control, and capture"
	description="A longer walkthrough of Ultiplay: Classic, Grid, Screen Maximize, and Mosaic layouts, playlists, streaming sources, and capture."
>
	<Nav />

	<main class="relative mx-auto max-w-5xl px-6 py-20 md:py-28">
		<div
			class="absolute inset-x-0 top-24 -z-10 h-96 bg-[radial-gradient(ellipse_at_center,_rgba(217,70,239,0.16),_transparent_70%)]"
		>
		</div>

		<header class="mb-10 text-center">
			<p class="text-xs font-semibold uppercase tracking-widest text-fuchsia-300">Tech demo</p>
			<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-5xl">
				The longer look.
			</h1>
			<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
				A deeper walkthrough of layout modes, control, and capture. Prefer the short spot?
				<a href="/#commercial" class="text-slate-300 underline decoration-white/15 underline-offset-4 transition hover:text-white">
					Watch the commercial
				</a>
				instead.
			</p>
		</header>

		<div class="relative">
			<div class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-r from-fuchsia-500/20 to-cyan-400/20 blur-3xl"></div>
			<div class="relative aspect-video overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl shadow-fuchsia-500/10">
				<iframe
					class="h-full w-full"
					src={MEDIA.techDemo.embedUrl}
					title={MEDIA.techDemo.title}
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				></iframe>
			</div>
		</div>

		<p class="mt-5 text-center text-sm text-slate-500">
			<a
				href={MEDIA.techDemo.watchUrl}
				target="_blank"
				rel="noopener"
				class="text-slate-400 underline decoration-white/15 underline-offset-4 transition hover:text-white"
			>
				Open on YouTube
			</a>
		</p>

		<div class="mt-12 flex flex-wrap items-center justify-center gap-4">
			<a
				href={ctaHref}
				class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-fuchsia-500 to-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 shadow-[0_0_30px_rgba(217,70,239,0.35)] transition hover:shadow-[0_0_40px_rgba(217,70,239,0.55)]"
			>
				{ctaLabel}
			</a>
			<a
				href="/#commercial"
				class="inline-flex items-center justify-center rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/30 hover:text-white"
			>
				Back to the commercial
			</a>
		</div>
	</main>

	<Footer />
</Layout>
